NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Template Generator (SumoPod — OpenAI-compatible)
# Daftar model: https://sumopod.com (atau lihat docs SumoPod)
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://api.sumopod.com/v1
SUMOPOD_MODEL=gpt-4o-mini

# Catatan: API key provider AI (chat & image) juga bisa diisi via
# Dashboard → Pengaturan → AI (tabel ai_providers di Supabase).
# Provider image memakai Replicate: daftar di https://replicate.com,
# token di https://replicate.com/account/api-tokens (format r8_...).
# Model default: black-forest-labs/flux-1.1-pro (gratis untuk dicoba)
